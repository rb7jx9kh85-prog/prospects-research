# Server-only secrets. Never prefix these variables with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your-server-only-key
MULTISOURCE_API_KEY=your-multisource-auth-key
# Generate with: openssl rand -hex 32
AUTH_SECRET=replace-with-at-least-32-random-characters

# Optional
SESSION_TTL_HOURS=12
MULTISOURCE_API_URL=https://api.multisource.ch/v2
