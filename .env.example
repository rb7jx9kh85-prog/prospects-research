# Server-only secrets. Never prefix these variables with NEXT_PUBLIC_.
MULTISOURCE_API_KEY=your-multisource-auth-key
# Generate with: openssl rand -hex 32
AUTH_SECRET=replace-with-at-least-32-random-characters

# Optional
SESSION_TTL_HOURS=12
MULTISOURCE_API_URL=https://api.multisource.ch/v2

# Provided automatically by Vercel when a Blob store is linked to the project.
# For local development, run `vercel link && vercel env pull .env.local`.
BLOB_READ_WRITE_TOKEN=
